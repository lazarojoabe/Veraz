# URL pública da aplicação (local ou Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente backend — não use o prefixo NEXT_PUBLIC_
ELEVENLABS_API_KEY=

# Opcional: usado apenas para estimativa de custo no histórico técnico
ELEVENLABS_SCRIBE_USD_PER_HOUR=0.22

# OpenAI Responses API — análise assistida de refeições por foto
OPENAI_API_KEY=
# Opcional: permite trocar o modelo sem alterar o código
OPENAI_VISION_MODEL=gpt-5.6-terra
